{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealseeker.local/schemas/add-offer-draft.schema.json",
  "title": "AddOfferDraft",
  "description": "Draft state for Add Offer view. Spec IDs: ADD.OFFER.LAYOUT.001, ADD.OFFER.IMAGE.001, ADD.OFFER.LOCATION.001, ADD.OFFER.DESCRIPTION.TAGS.001",
  "type": "object",
  "required": [
    "description",
    "tags",
    "image",
    "location"
  ],
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9\\- ]{0,63}$"
      },
      "uniqueItems": true
    },
    "image": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "source",
        "mimeType",
        "sizeBytes"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "camera",
            "gallery"
          ]
        },
        "mimeType": {
          "type": "string",
          "minLength": 1
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5242880
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "source",
        "lat",
        "lng"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "auto",
            "search",
            "manual-confirmed"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 250
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

