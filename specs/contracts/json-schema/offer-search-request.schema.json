{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealseeker.local/schemas/offer-search-request.schema.json",
  "title": "OfferSearchRequest",
  "description": "Contract for tag-based search input. Spec IDs: OFFERS.SEARCH.001",
  "type": "object",
  "required": [
    "query",
    "userLocation"
  ],
  "properties": {
    "query": {
      "type": "string",
      "maxLength": 120
    },
    "userLocation": {
      "type": "object",
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    },
    "radiusMeters": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50000,
      "default": 1000
    }
  },
  "additionalProperties": false
}

