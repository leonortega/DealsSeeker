{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealseeker.local/schemas/offer-search-request.schema.json",
  "title": "OfferSearchRequest",
  "description": "Contract for smart search input. Spec IDs: OFFERS.SEARCH.001, OFFERS.SEARCH.SMART.001, APP.LOCALIZATION.001",
  "type": "object",
  "required": [
    "query",
    "userLocation"
  ],
  "properties": {
    "query": {
      "type": "string",
      "maxLength": 120
    },
    "locale": {
      "type": "string",
      "description": "Selected app language/locale used for multilingual dictionary resolution.",
      "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
    },
    "userLocation": {
      "type": "object",
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    },
    "radiusMeters": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50000,
      "default": 1000
    },
    "favoritesOnly": {
      "type": "boolean",
      "default": false,
      "description": "Optional filter that limits the result set to offers saved by the current authenticated user."
    }
  },
  "additionalProperties": false
}
