{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealseeker.local/schemas/offer-search-response.schema.json",
  "title": "OfferSearchResponse",
  "description": "Contract for filtered offers and map businesses. Spec IDs: OFFERS.SEARCH.001, OFFERS.MAP.001, OFFERS.LIST.ACTIONS.001",
  "type": "object",
  "required": [
    "offers",
    "businesses"
  ],
  "properties": {
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "offerId",
          "businessId",
          "businessName",
          "description",
          "tags",
          "imageUrl",
          "isActive",
          "location",
          "distanceMeters",
          "hasCurrentUserVoted"
        ],
        "properties": {
          "offerId": {
            "type": "string",
            "minLength": 1
          },
          "businessId": {
            "type": "string",
            "minLength": 1
          },
          "businessName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "uniqueItems": true
          },
          "imageUrl": {
            "type": "string",
            "format": "uri-reference"
          },
          "isActive": {
            "type": "boolean"
          },
          "location": {
            "type": "object",
            "required": [
              "lat",
              "lng"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "additionalProperties": false
          },
          "distanceMeters": {
            "type": "number",
            "minimum": 0,
            "description": "Distance from current user location to this offer destination in meters."
          },
          "hasCurrentUserVoted": {
            "type": "boolean",
            "description": "True when the current authenticated user already cast availability feedback for this offer."
          }
        },
        "additionalProperties": false
      }
    },
    "businesses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "businessId",
          "name",
          "location",
          "distanceMeters"
        ],
        "properties": {
          "businessId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "required": [
              "lat",
              "lng"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "additionalProperties": false
          },
          "distanceMeters": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
