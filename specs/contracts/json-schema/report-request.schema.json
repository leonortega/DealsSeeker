{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealseeker.local/schemas/report-request.schema.json",
  "title": "ReportRequest",
  "description": "POST /api/reports and /api/complaints request. Mirrors DealsSeeker.Shared.Contracts.Feedback.ReportRequest.",
  "type": "object",
  "required": [
    "message"
  ],
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "offerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "userId": {
      "type": [
        "string",
        "null"
      ]
    },
    "reportedAtUtc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}