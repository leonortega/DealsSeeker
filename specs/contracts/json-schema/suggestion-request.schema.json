{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealseeker.local/schemas/suggestion-request.schema.json",
  "title": "SuggestionRequest",
  "description": "POST /api/suggestions request. Mirrors DealsSeeker.Shared.Contracts.Feedback.SuggestionRequest.",
  "type": "object",
  "required": [
    "message"
  ],
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "contact": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}