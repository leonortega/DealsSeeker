@inherits LayoutComponentBase
@inject IUserSessionService Session
@inject IAppPreferencesService Preferences
@inject IViewBusyService Busy
@implements IDisposable

<div class="page @GetThemeClass()">
    @if (_showStartupSplash)
    {
        <div class="startup-splash @(_splashExiting ? "exit" : string.Empty)" aria-hidden="true">
            <div class="startup-splash-content">
                <img src="/images/dealseeker-icon.svg" alt="" class="startup-splash-icon" />
                <p class="startup-splash-title">DealsSeeker</p>
                <p class="startup-splash-subtitle">Find nearby deals instantly</p>
            </div>
        </div>
    }
    @if (Busy.IsBusy)
    {
        <div class="view-busy-overlay" role="status" aria-live="polite">
            <div class="view-busy-spinner" aria-hidden="true"></div>
        </div>
    }

    <main>
        <div class="top-row px-4">
            <NavMenu />
            <div class="app-brand">
                <img src="/images/dealseeker-icon.svg" alt="" class="app-brand-icon" />
                <span class="app-title">DealsSeeker</span>
            </div>
        </div>

        <article class="content px-4" @key="_bodyRenderKey">
            @Body
        </article>
    </main>
</div>

@code {
    private string _bodyRenderKey = "en";
    private readonly CancellationTokenSource _splashCts = new();
    private bool _showStartupSplash = true;
    private bool _splashExiting;

    protected override async Task OnInitializedAsync()
    {
        Preferences.Changed += OnPreferencesChanged;
        Busy.Changed += OnBusyChanged;
        await Preferences.InitializeAsync(Session.CurrentSession?.UserId, CancellationToken.None);
        _bodyRenderKey = BuildBodyRenderKey();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = RunStartupSplashAsync(_splashCts.Token);
        }

        return Task.CompletedTask;
    }

    private void OnPreferencesChanged()
    {
        _bodyRenderKey = BuildBodyRenderKey();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnBusyChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private string GetThemeClass() => Preferences.ThemeMode switch
    {
        "light" => "theme-light",
        "dark" => "theme-dark",
        _ => "theme-system"
    };

    public void Dispose()
    {
        _splashCts.Cancel();
        _splashCts.Dispose();
        Preferences.Changed -= OnPreferencesChanged;
        Busy.Changed -= OnBusyChanged;
    }

    private string BuildBodyRenderKey() => Preferences.Language;

    private async Task RunStartupSplashAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(2000, cancellationToken);
            _splashExiting = true;
            await InvokeAsync(StateHasChanged);

            await Task.Delay(450, cancellationToken);
            _showStartupSplash = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }
}
