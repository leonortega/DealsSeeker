@inherits LayoutComponentBase
@inject IUserSessionService Session
@inject IAppPreferencesService Preferences
@inject IViewBusyService Busy
@inject IBackNavigationService BackNavigation
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable

<div class="page @GetThemeClass()">
    @if (Busy.IsBusy)
    {
        <div class="view-busy-overlay" role="status" aria-live="polite">
            <div class="view-busy-spinner" aria-hidden="true"></div>
        </div>
    }

    @if (_menuVisible)
    {
        <button class="menu-block-overlay @(_menuOpen ? "open" : string.Empty)"
                type="button"
                aria-label="@T("nav.closeNavigationMenu")"
                @onclick="CloseMenu">
        </button>

        <NavMenu IsOpen="_menuOpen" IsOpenChanged="OnMenuOpenChanged" ShowToggle="false" ShowSheet="true" />
    }

    <div class="shell-backdrop" aria-hidden="true">
        <span class="shell-orb shell-orb-one"></span>
        <span class="shell-orb shell-orb-two"></span>
        <span class="shell-grid"></span>
    </div>

    <main class="app-main @(_isImmersive ? "app-main-immersive" : string.Empty)">
        @if (!_isImmersive)
        {
            <header class="top-row">
                <div class="top-row-inner">
                    <div class="top-row-leading">
                        <div class="app-brand">
                            <img src="/images/dealseeker-icon.svg" alt="" class="app-brand-icon" />
                            <div class="app-brand-copy">
                                <span class="app-title">@T("app.title")</span>
                            </div>
                        </div>
                    </div>

                    <div class="top-row-trailing">
                        @if (Session.CurrentSession is { } activeSession)
                        {
                            <div class="top-row-user-block" title="@activeSession.Email" aria-label="@activeSession.DisplayName">
                                <div class="top-row-user">
                                    @GetUserInitial(activeSession.DisplayName)
                                </div>
                                <span class="top-row-user-name">@activeSession.DisplayName</span>
                            </div>
                        }

                        @if (_isStandardOffers)
                        {
                            <button class="btn-immersive" @onclick="OpenImmersiveView">
                                @T("offers.immersiveView")
                            </button>
                        }

                        <NavMenu IsOpen="_menuOpen" IsOpenChanged="OnMenuOpenChanged" ShowToggle="true" ShowSheet="false" />
                    </div>
                </div>
            </header>
        }

        <article class="content @(_isImmersive ? "content-immersive" : string.Empty)" @key="_bodyRenderKey">
            @Body
        </article>
    </main>
</div>

@code {
    private const int MenuAnimationDurationMs = 220;
    private string _bodyRenderKey = "en";
    private bool _menuOpen;
    private bool _menuVisible;
    private bool _isImmersive;
    private bool _isStandardOffers;
    private CancellationTokenSource? _menuAnimationCts;
    private readonly List<string> _backStack = [];
    private Func<Task<bool>>? _backHandler;
    private string? _expectedBackLocation;

    protected override async Task OnInitializedAsync()
    {
        Preferences.Changed += OnPreferencesChanged;
        Busy.Changed += OnBusyChanged;
        Navigation.LocationChanged += OnLocationChanged;
        UpdateRouteFlags();
        RecordLocation(CurrentLocation());
        _backHandler = TryNavigateBackAsync;
        BackNavigation.Register(_backHandler);
        await Preferences.InitializeAsync(Session.CurrentSession?.UserId, CancellationToken.None);
        _bodyRenderKey = BuildBodyRenderKey();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        TrackBackStack();
        UpdateRouteFlags();
        _ = InvokeAsync(StateHasChanged);
    }

    private void TrackBackStack() => RecordLocation(CurrentLocation());

    private void RecordLocation(string location)
    {
        if (_expectedBackLocation is not null &&
            string.Equals(location, _expectedBackLocation, StringComparison.OrdinalIgnoreCase))
        {
            _expectedBackLocation = null;
            return;
        }

        // Entry and redirect views (/ , /login, /create-user) are never back targets: returning to
        // them would replay a redirect or show an authentication view again.
        if (IsTransientEntryView(location))
        {
            return;
        }

        if (_backStack.Count > 0 &&
            string.Equals(_backStack[^1], location, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _backStack.Add(location);
    }

    private static bool IsTransientEntryView(string location)
    {
        var path = location.Split('?')[0];
        return path.Equals("/", StringComparison.OrdinalIgnoreCase) ||
               path.Equals("/login", StringComparison.OrdinalIgnoreCase) ||
               path.Equals("/create-user", StringComparison.OrdinalIgnoreCase);
    }

    private string CurrentLocation()
    {
        var uri = new Uri(Navigation.Uri);
        var path = uri.AbsolutePath.TrimEnd('/');
        if (string.IsNullOrEmpty(path))
        {
            path = "/";
        }

        return string.Concat(path, uri.Query);
    }

    private Task<bool> TryNavigateBackAsync()
    {
        var completion = new TaskCompletionSource<bool>();
        _ = InvokeAsync(async () =>
        {
            try
            {
                completion.TrySetResult(await NavigateBackCoreAsync());
            }
            catch (Exception ex)
            {
                completion.TrySetException(ex);
            }
        });

        return completion.Task;
    }

    private Task<bool> NavigateBackCoreAsync()
    {
        if (_backStack.Count <= 1)
        {
            return Task.FromResult(false);
        }

        _backStack.RemoveAt(_backStack.Count - 1);
        var target = _backStack[^1];
        Serilog.Log.Debug("Back navigation targeting {Target}. Stack={Stack}", target, string.Join(" > ", _backStack));
        if (string.Equals(target, CurrentLocation(), StringComparison.OrdinalIgnoreCase))
        {
            return Task.FromResult(_backStack.Count > 1);
        }

        _expectedBackLocation = target;
        Navigation.NavigateTo(target, forceLoad: false);
        return Task.FromResult(true);
    }

    private void UpdateRouteFlags()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        _isImmersive = path.Equals("/offers/immersive", StringComparison.OrdinalIgnoreCase);
        _isStandardOffers = path.Equals("/offers", StringComparison.OrdinalIgnoreCase);
    }

    private void OpenImmersiveView() => Navigation.NavigateTo("/offers/immersive");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("DealsSeekerStartup.complete");
        }
    }

    private void OnPreferencesChanged()
    {
        _bodyRenderKey = BuildBodyRenderKey();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnBusyChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnMenuOpenChanged(bool isOpen)
    {
        CancelMenuAnimation();

        if (isOpen)
        {
            _menuVisible = true;
            _menuOpen = false;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
            _menuOpen = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _menuOpen = false;
        await InvokeAsync(StateHasChanged);

        _menuAnimationCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(MenuAnimationDurationMs, _menuAnimationCts.Token);
            _menuVisible = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task CloseMenu()
    {
        return OnMenuOpenChanged(false);
    }

    private string GetThemeClass() => Preferences.ThemeMode switch
    {
        "light" => "theme-light",
        "dark" => "theme-dark",
        _ => "theme-system"
    };

    private string T(string key) => Preferences.Translate(key);

    public void Dispose()
    {
        Preferences.Changed -= OnPreferencesChanged;
        Busy.Changed -= OnBusyChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        if (_backHandler is not null)
        {
            BackNavigation.Unregister(_backHandler);
            _backHandler = null;
        }

        _menuAnimationCts?.Cancel();
        _menuAnimationCts?.Dispose();
    }

    private string BuildBodyRenderKey() => Preferences.Language;

    private void CancelMenuAnimation()
    {
        _menuAnimationCts?.Cancel();
        _menuAnimationCts?.Dispose();
        _menuAnimationCts = null;
    }

    private static string GetUserInitial(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "D";
        }

        return char.ToUpperInvariant(value.Trim()[0]).ToString();
    }
}
