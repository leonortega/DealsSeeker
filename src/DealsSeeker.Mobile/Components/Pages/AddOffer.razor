@page "/add-offer"
@inject IMediaCaptureService MediaCapture
@inject IDeviceLocationService DeviceLocation
@inject IDealsSeekerApiClient ApiClient
@inject IMapRenderingService MapRendering
@inject IUserSessionService Session
@inject IAppPreferencesService Preferences
@inject NavigationManager Navigation
@implements IDisposable

<h1>@T("addOffer.title")</h1>

<section class="card-block">
    <h2>@T("addOffer.images")</h2>
    <div class="photo-preview-shell">
        @if (_images.Count == 0)
        {
            <div class="image-placeholder photo-preview-empty">
                <span class="photo-icon">@T("addOffer.photoPlaceholder")</span>
            </div>
        }
        else
        {
            var currentImage = CurrentImage();
            <div class="photo-preview-stage">
                @if (_images.Count > 1)
                {
                    <button class="photo-preview-nav photo-preview-nav-prev"
                            @onclick="ShowPreviousImage"
                            aria-label="@T("addOffer.previousPhoto")">
                        <span class="photo-preview-nav-arrow" aria-hidden="true">&#8592;</span>
                    </button>
                }
                <img src="@currentImage.DataUrl"
                     alt="@($"{T("addOffer.previewAlt")} {CurrentImageNumber()}")"
                     class="photo-preview-image" />
                @if (_images.Count > 1)
                {
                    <button class="photo-preview-nav photo-preview-nav-next"
                            @onclick="ShowNextImage"
                            aria-label="@T("addOffer.nextPhoto")">
                        <span class="photo-preview-nav-arrow" aria-hidden="true">&#8594;</span>
                    </button>
                }
                <span class="photo-preview-count">@CurrentImageNumber() / @_images.Count</span>
            </div>
        }
    </div>

    <div class="action-row photo-action-bar">
        <button class="btn-main" @onclick="CaptureFromCameraAsync">@T("addOffer.takePhoto")</button>
        <button class="btn-main" @onclick="UploadFromGalleryAsync">@T("addOffer.uploadPhotos")</button>
        @if (_images.Count > 0)
        {
            <button class="btn-main btn-order"
                    @onclick="() => MoveCurrentImage(-1)"
                    disabled="@(!CanMoveCurrentImage(-1))"
                    aria-label="@T("addOffer.movePhotoEarlier")">
                <span class="btn-order-icon" aria-hidden="true">&#8678;</span>
                <span>@T("addOffer.movePhotoEarlier")</span>
            </button>
            <button class="btn-main btn-order"
                    @onclick="() => MoveCurrentImage(1)"
                    disabled="@(!CanMoveCurrentImage(1))"
                    aria-label="@T("addOffer.movePhotoLater")">
                <span class="btn-order-icon" aria-hidden="true">&#8680;</span>
                <span>@T("addOffer.movePhotoLater")</span>
            </button>
            <button class="btn-main btn-danger" @onclick="RemoveCurrentImage">@T("addOffer.remove")</button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_imageStatus))
    {
        <p class="status-line">@_imageStatus</p>
    }
</section>

<section class="card-block">
    <h2>@T("addOffer.location")</h2>
    <p class="muted">@T("addOffer.currentAddress"): @FormatLocation(_location)</p>

    <label class="field-label" for="locationQuery">@T("addOffer.searchAddressLabel")</label>
    <div class="search-row">
        <input id="locationQuery"
               name="locationQuery"
               class="field-input"
               placeholder="@T("addOffer.searchAddressPlaceholder")"
               value="@_locationQuery"
               @oninput="OnLocationQueryInputAsync"
               disabled="@_isLocationConfirmed" />
    </div>
    @if (_searchingLocation)
    {
        <p class="muted">@T("addOffer.searchingLocations")</p>
    }
    else if (_locationQuery.Trim().Length > 0 && _locationQuery.Trim().Length < 3)
    {
        <p class="muted">@T("addOffer.typeAtLeast3Chars")</p>
    }
    @if (!string.IsNullOrWhiteSpace(_locationStatus))
    {
        <p class="status-line">@_locationStatus</p>
    }

    @if (_locationResults.Count > 0)
    {
        <div class="location-suggestion-list" role="listbox" aria-label="@T("addOffer.addressSuggestionsAria")">
            @foreach (var result in _locationResults)
            {
                <button class="location-suggestion-item" @onclick="() => SelectLocation(result)">
                    <span class="location-suggestion-title">@result.Label</span>
                    <span class="location-suggestion-subtitle">@T("addOffer.tapToSetAddress")</span>
                </button>
            }
        </div>
    }

    <h3>@T("addOffer.locationPreview")</h3>
    <iframe class="map-frame" src="@BuildLocationMapUrl()" loading="lazy"></iframe>
    <div class="action-row">
        <button class="btn-main"
                @onclick="ConfirmLocation"
                disabled="@(_isLocationConfirmed || _location is null)">@T("addOffer.confirmLocation")</button>
        <button class="btn-main btn-warning"
                @onclick="EditLocation"
                disabled="@(!_isLocationConfirmed)">@T("addOffer.editLocation")</button>
    </div>
</section>

<section class="card-block">
    <h2>@T("addOffer.tags")</h2>
    <label class="field-label" for="descriptionInput">@T("addOffer.description")</label>
    <textarea id="descriptionInput"
              name="descriptionInput"
              class="field-input"
              rows="4"
              value="@_description"
              @oninput="OnDescriptionInput"></textarea>

    @{
        var detectedWords = ExtractWords(_description);
    }
    <div class="tag-section-block">
        <label class="field-label">@T("addOffer.detectedWords")</label>
        <p class="muted">@T("addOffer.tapWordToTag")</p>
        @if (detectedWords.Count == 0)
        {
            <p class="muted">@T("addOffer.noDetectedWords")</p>
        }
        else
        {
            <div class="word-list">
                @foreach (var word in detectedWords)
                {
                    <button class="word-chip" @onclick="() => AddTag(word)">
                        @word
                    </button>
                }
            </div>
        }
    </div>

    <div class="tag-section-block">
        <label class="field-label">@T("addOffer.selectedTags")</label>
        @if (_tags.Count == 0)
        {
            <p class="muted">@T("addOffer.noSelectedTags")</p>
        }
        else
        {
            <div class="tag-list">
                @foreach (var tag in _tags)
                {
                    <span class="tag-pill">
                        @tag
                        <button class="tag-remove" @onclick="() => RemoveTag(tag)">x</button>
                    </span>
                }
            </div>
        }
    </div>

    @{
        var suggestedTags = GetSuggestedTags();
    }
    <div class="tag-section-block">
        <label class="field-label">@T("addOffer.suggestions")</label>
        <p class="muted">@T("addOffer.suggestedTagsHelp")</p>
        @if (_tags.Count == 0)
        {
            <p class="muted">@T("addOffer.selectTagForSuggestions")</p>
        }
        else if (suggestedTags.Count == 0)
        {
            <p class="muted">@T("addOffer.noSuggestedTags")</p>
        }
        else
        {
            <div class="word-list">
                @foreach (var suggestion in suggestedTags)
                {
                    <button class="word-chip" @onclick="() => AddTag(suggestion)">
                        @suggestion
                    </button>
                }
            </div>
        }
    </div>
</section>

<section class="card-block">
    <button class="btn-main" @onclick="CreateOfferAsync" disabled="@_saving">@T("addOffer.create")</button>
    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <p class="status-line">@_status</p>
    }
</section>

@code {
    private const int MaxPhotos = 8;
    private const double SuggestionThreshold = 0.72d;

    private static readonly IReadOnlyDictionary<string, IReadOnlyDictionary<string, IReadOnlyList<string>>> SuggestionDictionary
        = new Dictionary<string, IReadOnlyDictionary<string, IReadOnlyList<string>>>(StringComparer.OrdinalIgnoreCase)
        {
            ["en"] = new Dictionary<string, IReadOnlyList<string>>(StringComparer.OrdinalIgnoreCase)
            {
                ["coffee"] = ["coffees", "cafe", "cafes", "espresso", "espressos", "latte", "lattes"],
                ["tea"] = ["teas", "chai", "infusion", "infusions"],
                ["bakery"] = ["bakeries", "bread", "breads", "pastry", "pastries"],
                ["discount"] = ["discounts", "deal", "deals", "promo", "promos", "sale", "sales"],
                ["offer"] = ["offers", "deal", "deals", "promo", "promos"]
            },
            ["es"] = new Dictionary<string, IReadOnlyList<string>>(StringComparer.OrdinalIgnoreCase)
            {
                ["cafe"] = ["cafes", "coffee", "espresso", "espressos"],
                ["te"] = ["tes", "tea", "infusion", "infusiones"],
                ["panaderia"] = ["panaderias", "bakery", "bread", "pan"],
                ["descuento"] = ["descuentos", "discount", "deal", "promo", "promos"],
                ["oferta"] = ["ofertas", "deal", "deals", "promo", "promos"]
            }
        };

    private readonly List<PickedImage> _images = [];
    private OfferLocationDto? _location;
    private string _description = string.Empty;
    private string _locationQuery = string.Empty;
    private string _status = string.Empty;
    private string _locationStatus = string.Empty;
    private string _imageStatus = string.Empty;
    private bool _saving;
    private bool _searchingLocation;
    private bool _isLocationConfirmed;
    private CancellationTokenSource? _locationSearchCts;
    private readonly List<string> _tags = [];
    private readonly List<LocationSearchResultDto> _locationResults = [];
    private int _selectedImageIndex;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", forceLoad: false);
            return;
        }

        await Preferences.InitializeAsync(Session.CurrentSession?.UserId, CancellationToken.None);
        await TryAutoPopulateLocationAsync();
    }

    private async Task CaptureFromCameraAsync()
    {
        if (_images.Count >= MaxPhotos)
        {
            _imageStatus = string.Format(T("addOffer.maxPhotosReached"), MaxPhotos);
            return;
        }

        var captured = await MediaCapture.CapturePhotoAsync(CancellationToken.None);
        if (captured is null)
        {
            _imageStatus = T("addOffer.cameraDenied");
            return;
        }

        _images.Add(captured);
        _selectedImageIndex = _images.Count - 1;
        _imageStatus = T("addOffer.photoAttached");
        await TryAutoPopulateLocationAsync();
    }

    private async Task UploadFromGalleryAsync()
    {
        if (_images.Count >= MaxPhotos)
        {
            _imageStatus = string.Format(T("addOffer.maxPhotosReached"), MaxPhotos);
            return;
        }

        var picked = await MediaCapture.PickPhotosAsync(CancellationToken.None);
        if (picked.Count == 0)
        {
            _imageStatus = T("addOffer.imageUploadCancelled");
            return;
        }

        var firstNewIndex = _images.Count;
        foreach (var photo in picked)
        {
            if (_images.Count >= MaxPhotos)
            {
                break;
            }

            _images.Add(photo);
        }

        if (_images.Count > firstNewIndex)
        {
            _selectedImageIndex = firstNewIndex;
        }

        _imageStatus = T("addOffer.imagesAttachedFromGallery");
        await TryAutoPopulateLocationAsync();
    }

    private void MoveImage(int index, int delta)
    {
        var target = index + delta;
        if (index < 0 || index >= _images.Count || target < 0 || target >= _images.Count)
        {
            return;
        }

        (_images[index], _images[target]) = (_images[target], _images[index]);
        if (_selectedImageIndex == index)
        {
            _selectedImageIndex = target;
        }
        else if (_selectedImageIndex == target)
        {
            _selectedImageIndex = index;
        }
        _imageStatus = T("addOffer.photoOrderUpdated");
    }

    private void RemoveImage(int index)
    {
        if (index < 0 || index >= _images.Count)
        {
            return;
        }

        _images.RemoveAt(index);
        ClampSelectedImageIndex();
        _imageStatus = T("addOffer.photoRemoved");
    }

    private PickedImage CurrentImage() => _images[Math.Clamp(_selectedImageIndex, 0, _images.Count - 1)];

    private int CurrentImageNumber() => Math.Clamp(_selectedImageIndex, 0, Math.Max(0, _images.Count - 1)) + 1;

    private void ShowPreviousImage()
    {
        if (_images.Count <= 1)
        {
            return;
        }

        _selectedImageIndex = (_selectedImageIndex - 1 + _images.Count) % _images.Count;
    }

    private void ShowNextImage()
    {
        if (_images.Count <= 1)
        {
            return;
        }

        _selectedImageIndex = (_selectedImageIndex + 1) % _images.Count;
    }

    private void MoveCurrentImage(int delta) => MoveImage(_selectedImageIndex, delta);

    private bool CanMoveCurrentImage(int delta)
    {
        if (_images.Count == 0)
        {
            return false;
        }

        var target = _selectedImageIndex + delta;
        return target >= 0 && target < _images.Count;
    }

    private void RemoveCurrentImage() => RemoveImage(_selectedImageIndex);

    private void ClampSelectedImageIndex()
    {
        if (_images.Count == 0)
        {
            _selectedImageIndex = 0;
            return;
        }

        _selectedImageIndex = Math.Clamp(_selectedImageIndex, 0, _images.Count - 1);
    }

    private async Task TryAutoPopulateLocationAsync()
    {
        var point = await DeviceLocation.TryGetCurrentLocationAsync(CancellationToken.None);
        if (point is null)
        {
            _locationStatus = T("addOffer.currentLocationUnavailable");
            return;
        }

        if (_location is null || !_isLocationConfirmed)
        {
            var label = await ResolveAutoLocationLabelAsync(point);
            _location = new OfferLocationDto("auto", label, point);
            _locationQuery = label;
            _locationStatus = T("addOffer.currentLocationAuto");
        }
    }

    private void ConfirmLocation()
    {
        if (_location is null)
        {
            _locationStatus = T("addOffer.noLocationSelected");
            return;
        }

        _location = _location with { Source = "manual-confirmed" };
        _isLocationConfirmed = true;
        _locationStatus = T("addOffer.locationConfirmed");
    }

    private void EditLocation()
    {
        _isLocationConfirmed = false;
        _locationStatus = T("addOffer.locationEditEnabled");
    }

    private async Task OnLocationQueryInputAsync(ChangeEventArgs args)
    {
        if (_isLocationConfirmed)
        {
            return;
        }

        _locationQuery = args.Value?.ToString() ?? string.Empty;
        await SearchLocationSuggestionsAsync();
    }

    private async Task SearchLocationSuggestionsAsync()
    {
        _locationSearchCts?.Cancel();
        _locationSearchCts?.Dispose();
        _locationSearchCts = new CancellationTokenSource();
        var token = _locationSearchCts.Token;

        var trimmed = _locationQuery.Trim();
        if (trimmed.Length < 3)
        {
            _searchingLocation = false;
            _locationStatus = string.Empty;
            _locationResults.Clear();
            return;
        }

        _searchingLocation = true;
        _locationStatus = string.Empty;
        try
        {
            await Task.Delay(300, token);

            _locationResults.Clear();
            var results = await ApiClient.SearchLocationsAsync(trimmed, token);
            if (token.IsCancellationRequested)
            {
                return;
            }

            _locationResults.AddRange(results);
            if (_locationResults.Count == 0)
            {
                _locationStatus = T("addOffer.noLocationResults");
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            if (!token.IsCancellationRequested)
            {
                _locationStatus = T("addOffer.locationSearchFailed");
            }
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _searchingLocation = false;
            }
        }
    }

    private void SelectLocation(LocationSearchResultDto result)
    {
        _location = new OfferLocationDto("search", result.Label, result.Position);
        _locationQuery = result.Label;
        _isLocationConfirmed = false;
        _locationStatus = T("addOffer.locationSelectedFromSuggestions");
        _locationResults.Clear();
    }

    private void OnDescriptionInput(ChangeEventArgs args)
    {
        _description = args.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_description))
        {
            _tags.Clear();
        }
    }

    private void AddTag(string value)
    {
        var normalized = NormalizeTag(value);
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return;
        }

        if (_tags.Contains(normalized, StringComparer.OrdinalIgnoreCase))
        {
            return;
        }

        _tags.Add(normalized);
    }

    private void RemoveTag(string tag)
    {
        _tags.Remove(tag);
    }

    private IReadOnlyList<string> GetSuggestedTags()
    {
        if (_tags.Count == 0)
        {
            return [];
        }

        var language = Preferences.Language;
        if (!SuggestionDictionary.TryGetValue(language, out var dictionary))
        {
            dictionary = SuggestionDictionary["en"];
        }

        var suggestions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var selectedTag in _tags.Select(NormalizeTag))
        {
            if (string.IsNullOrWhiteSpace(selectedTag))
            {
                continue;
            }

            foreach (var variant in ExpandTagVariants(selectedTag, language))
            {
                suggestions.Add(variant);
            }

            foreach (var relatedTag in FindRelatedTags(selectedTag, language, dictionary))
            {
                suggestions.Add(relatedTag);
            }
        }

        return suggestions
            .Where(x => !_tags.Contains(x, StringComparer.OrdinalIgnoreCase))
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .Take(12)
            .ToArray();
    }

    private static IEnumerable<string> FindRelatedTags(
        string selectedTag,
        string language,
        IReadOnlyDictionary<string, IReadOnlyList<string>> dictionary)
    {
        var selectedForms = ExpandComparisonForms(selectedTag, language);

        foreach (var entry in dictionary)
        {
            var normalizedKey = NormalizeTag(entry.Key);
            if (string.IsNullOrWhiteSpace(normalizedKey))
            {
                continue;
            }

            var keyForms = ExpandComparisonForms(normalizedKey, language);
            var matches = selectedForms.Overlaps(keyForms) ||
                selectedForms.Any(form => SimilarityRatio(normalizedKey, form) >= SuggestionThreshold);

            if (!matches)
            {
                continue;
            }

            yield return normalizedKey;
            foreach (var synonym in entry.Value.Select(NormalizeTag).Where(x => !string.IsNullOrWhiteSpace(x)))
            {
                yield return synonym;
            }
        }
    }

    private static HashSet<string> ExpandComparisonForms(string value, string language)
    {
        var forms = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var variant in ExpandTagVariants(value, language))
        {
            forms.Add(variant);
        }

        return forms;
    }

    private static IEnumerable<string> ExpandTagVariants(string value, string language)
    {
        var normalized = NormalizeTag(value);
        if (string.IsNullOrWhiteSpace(normalized))
        {
            yield break;
        }

        var variants = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            normalized,
            ToSingular(normalized, language),
            ToPlural(normalized, language)
        };

        foreach (var variant in variants.Where(x => !string.IsNullOrWhiteSpace(x)))
        {
            yield return variant;
        }
    }

    private static string ToSingular(string value, string language)
    {
        if (string.IsNullOrWhiteSpace(value) || value.EndsWith('%'))
        {
            return value;
        }

        if (string.Equals(language, "es", StringComparison.OrdinalIgnoreCase))
        {
            if (value.EndsWith("ces", StringComparison.OrdinalIgnoreCase) && value.Length > 3)
            {
                return value[..^3] + "z";
            }

            if (value.EndsWith('s') && value.Length > 3)
            {
                if (value.EndsWith("es", StringComparison.OrdinalIgnoreCase) &&
                    !IsVowel(value[value.Length - 3]) &&
                    !value.EndsWith("aes", StringComparison.OrdinalIgnoreCase) &&
                    !value.EndsWith("ees", StringComparison.OrdinalIgnoreCase) &&
                    !value.EndsWith("oes", StringComparison.OrdinalIgnoreCase))
                {
                    return value[..^2];
                }

                return value[..^1];
            }

            return value;
        }

        if (value.EndsWith("ies", StringComparison.OrdinalIgnoreCase) && value.Length > 3)
        {
            return value[..^3] + "y";
        }

        if ((value.EndsWith("ches", StringComparison.OrdinalIgnoreCase) ||
            value.EndsWith("shes", StringComparison.OrdinalIgnoreCase) ||
            value.EndsWith("sses", StringComparison.OrdinalIgnoreCase) ||
            value.EndsWith("xes", StringComparison.OrdinalIgnoreCase) ||
            value.EndsWith("zes", StringComparison.OrdinalIgnoreCase)) &&
            value.Length > 2)
        {
            return value[..^2];
        }

        if (value.EndsWith('s') && !value.EndsWith("ss", StringComparison.OrdinalIgnoreCase) && value.Length > 1)
        {
            return value[..^1];
        }

        return value;
    }

    private static string ToPlural(string value, string language)
    {
        if (string.IsNullOrWhiteSpace(value) || value.EndsWith('%'))
        {
            return value;
        }

        if (!string.Equals(ToSingular(value, language), value, StringComparison.OrdinalIgnoreCase))
        {
            return value;
        }

        if (string.Equals(language, "es", StringComparison.OrdinalIgnoreCase))
        {
            if (value.EndsWith('z'))
            {
                return value[..^1] + "ces";
            }

            return IsVowel(value[^1]) ? string.Concat(value, "s") : string.Concat(value, "es");
        }

        if (value.EndsWith('y') && value.Length > 1 && !IsVowel(value[^2]))
        {
            return value[..^1] + "ies";
        }

        if (value.EndsWith('s') ||
            value.EndsWith('x') ||
            value.EndsWith('z') ||
            value.EndsWith("ch", StringComparison.OrdinalIgnoreCase) ||
            value.EndsWith("sh", StringComparison.OrdinalIgnoreCase))
        {
            return string.Concat(value, "es");
        }

        return string.Concat(value, "s");
    }

    private static bool IsVowel(char value)
    {
        var lowered = char.ToLowerInvariant(value);
        return lowered is 'a' or 'e' or 'i' or 'o' or 'u';
    }

    private async Task CreateOfferAsync()
    {
        _saving = true;
        _status = string.Empty;
        try
        {
            var orderedImages = _images
                .Select((picked, index) => picked.Metadata with { Order = index })
                .ToArray();

            var request = new AddOfferRequest(
                _description.Trim(),
                _tags.ToArray(),
                orderedImages,
                _location);

            var created = await ApiClient.CreateOfferAsync(request, CancellationToken.None);
            if (created is null)
            {
                _status = T("addOffer.createFailed");
                return;
            }

            _status = string.Format(T("addOffer.createdWithId"), created.OfferId);
            Navigation.NavigateTo("/offers", forceLoad: false);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string NormalizeTag(string value) =>
        (value ?? string.Empty)
            .Trim()
            .Trim('.', ',', ';', ':', '!', '?', '"', '\'', '(', ')', '[', ']', '{', '}')
            .ToLowerInvariant();

    private static IReadOnlyList<string> ExtractWords(string text) =>
        Regex.Matches(text ?? string.Empty, "\\b[\\p{L}\\p{Nd}][\\p{L}\\p{Nd}\\-']*%?(?=\\b|\\s|$|[.,;:!?])")
            .Select(m => m.Value)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(30)
            .ToArray();

    private string FormatLocation(OfferLocationDto? location) =>
        location is null
            ? T("addOffer.locationUnavailable")
            : location.Label ?? T("addOffer.currentLocation");

    private string BuildLocationMapUrl()
    {
        if (_location is null)
        {
            return MapRendering.BuildMapEmbedUrl(new GeoPoint(40.7128, -74.0060), [], zoom: 14);
        }

        return MapRendering.BuildLocationPreviewMapUrl(_location.Position, _location.Label, zoom: 15);
    }

    private async Task<string> ResolveAutoLocationLabelAsync(GeoPoint point)
    {
        try
        {
            var result = await ApiClient.ReverseLocationAsync(point, CancellationToken.None);
            if (!string.IsNullOrWhiteSpace(result?.Label))
            {
                return result.Label.Trim();
            }
        }
        catch
        {
        }

        return T("addOffer.currentLocation");
    }

    private string T(string key) => Preferences.Translate(key);

    private static double SimilarityRatio(string left, string right)
    {
        if (left.Length == 0 && right.Length == 0)
        {
            return 1d;
        }

        var maxLength = Math.Max(left.Length, right.Length);
        if (maxLength == 0)
        {
            return 1d;
        }

        var distance = LevenshteinDistance(left, right);
        return 1d - ((double)distance / maxLength);
    }

    private static int LevenshteinDistance(string source, string target)
    {
        var sourceLength = source.Length;
        var targetLength = target.Length;
        var matrix = new int[sourceLength + 1, targetLength + 1];

        for (var i = 0; i <= sourceLength; i++)
        {
            matrix[i, 0] = i;
        }

        for (var j = 0; j <= targetLength; j++)
        {
            matrix[0, j] = j;
        }

        for (var i = 1; i <= sourceLength; i++)
        {
            for (var j = 1; j <= targetLength; j++)
            {
                var cost = source[i - 1] == target[j - 1] ? 0 : 1;
                matrix[i, j] = Math.Min(
                    Math.Min(matrix[i - 1, j] + 1, matrix[i, j - 1] + 1),
                    matrix[i - 1, j - 1] + cost);
            }
        }

        return matrix[sourceLength, targetLength];
    }

    public void Dispose()
    {
        _locationSearchCts?.Cancel();
        _locationSearchCts?.Dispose();
    }
}
