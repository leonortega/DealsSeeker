@page "/add-offer"
@inject IMediaCaptureService MediaCapture
@inject IDeviceLocationService DeviceLocation
@inject IDealsSeekerApiClient ApiClient
@inject IMapRenderingService MapRendering
@inject NavigationManager Navigation
@implements IDisposable

<h1>Add Offer</h1>

<section class="card-block">
    <h2>Image</h2>
    <button class="image-placeholder" @onclick="CaptureFromCameraAsync">
        @if (_image is null)
        {
            <span class="photo-icon">[ photo ]</span>
        }
        else
        {
            <img src="@_image.DataUrl" alt="Offer preview" class="offer-image" />
        }
    </button>
    <div class="action-row">
        <button class="btn-main" @onclick="CaptureFromCameraAsync">Take Photo</button>
        <button class="btn-main" @onclick="UploadFromGalleryAsync">Upload Image</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(_imageStatus))
    {
        <p class="status-line">@_imageStatus</p>
    }
</section>

<section class="card-block">
    <h2>Location</h2>
    <p class="muted">Current address: @FormatLocation(_location)</p>

    <label class="field-label" for="locationQuery">Search business or address</label>
    <div class="search-row">
        <input id="locationQuery"
               name="locationQuery"
               class="field-input"
               placeholder="Type business or address (min 3 chars)..."
               value="@_locationQuery"
               @oninput="OnLocationQueryInputAsync"
               disabled="@_isLocationConfirmed" />
    </div>
    @if (_searchingLocation)
    {
        <p class="muted">Searching locations...</p>
    }
    else if (_locationQuery.Trim().Length > 0 && _locationQuery.Trim().Length < 3)
    {
        <p class="muted">Type at least 3 characters to see suggestions.</p>
    }
    @if (!string.IsNullOrWhiteSpace(_locationStatus))
    {
        <p class="status-line">@_locationStatus</p>
    }

    @if (_locationResults.Count > 0)
    {
        <div class="location-suggestion-list" role="listbox" aria-label="Address suggestions">
            @foreach (var result in _locationResults)
            {
                <button class="location-suggestion-item" @onclick="() => SelectLocation(result)">
                    <span class="location-suggestion-title">@result.Label</span>
                    <span class="location-suggestion-subtitle">Tap to set this address</span>
                </button>
            }
        </div>
    }

    <h3>Location Preview</h3>
    <iframe class="map-frame" src="@BuildLocationMapUrl()" loading="lazy"></iframe>
    <div class="action-row">
        <button class="btn-main"
                @onclick="ConfirmLocation"
                disabled="@(_isLocationConfirmed || _location is null)">Confirm Location</button>
        <button class="btn-main btn-warning"
                @onclick="EditLocation"
                disabled="@(!_isLocationConfirmed)">Edit Location</button>
    </div>
</section>

<section class="card-block">
    <h2>Description and Tags</h2>
    <label class="field-label" for="descriptionInput">Description</label>
    <textarea id="descriptionInput"
              name="descriptionInput"
              class="field-input"
              rows="4"
              @bind="_description"
              @bind:event="oninput"></textarea>

    <p class="muted">Tap any detected word to create a tag instantly.</p>
    <div class="word-list">
        @foreach (var word in ExtractWords(_description))
        {
            <button class="word-chip" @onclick="() => AddTag(word)">
                @word
            </button>
        }
    </div>

    <label class="field-label" for="manualTagInput">Add tag manually</label>
    <div class="search-row">
        <input id="manualTagInput"
               name="manualTagInput"
               class="field-input"
               placeholder="Add tag manually..."
               @bind="_manualTag" />
        <button class="btn-main" @onclick="AddManualTag">Add Tag</button>
    </div>

    <div class="tag-list">
        @foreach (var tag in _tags)
        {
            <span class="tag-pill">
                @tag
                <button class="tag-remove" @onclick="() => RemoveTag(tag)">x</button>
            </span>
        }
    </div>
</section>

<section class="card-block">
    <button class="btn-main" @onclick="CreateOfferAsync" disabled="@_saving">Create Offer</button>
    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <p class="status-line">@_status</p>
    }
</section>

@code {
    private PickedImage? _image;
    private OfferLocationDto? _location;
    private string _description = string.Empty;
    private string _manualTag = string.Empty;
    private string _locationQuery = string.Empty;
    private string _status = string.Empty;
    private string _locationStatus = string.Empty;
    private string _imageStatus = string.Empty;
    private bool _saving;
    private bool _searchingLocation;
    private bool _isLocationConfirmed;
    private CancellationTokenSource? _locationSearchCts;
    private readonly List<string> _tags = [];
    private readonly List<LocationSearchResultDto> _locationResults = [];

    protected override async Task OnInitializedAsync()
    {
        await TryAutoPopulateLocationAsync();
    }

    private async Task CaptureFromCameraAsync()
    {
        _image = await MediaCapture.CapturePhotoAsync(CancellationToken.None);
        _imageStatus = _image is null ? "Camera permission denied or capture cancelled." : "Photo attached.";
        if (_image is not null)
        {
            await TryAutoPopulateLocationAsync();
        }
    }

    private async Task UploadFromGalleryAsync()
    {
        _image = await MediaCapture.PickPhotoAsync(CancellationToken.None);
        _imageStatus = _image is null ? "Image upload cancelled." : "Image attached from gallery.";
        if (_image is not null)
        {
            await TryAutoPopulateLocationAsync();
        }
    }

    private async Task TryAutoPopulateLocationAsync()
    {
        var point = await DeviceLocation.TryGetCurrentLocationAsync(CancellationToken.None);
        if (point is null)
        {
            _locationStatus = "Current location unavailable.";
            return;
        }

        if (_location is null || !_isLocationConfirmed)
        {
            var label = await ResolveAutoLocationLabelAsync(point);
            _location = new OfferLocationDto("auto", label, point);
            _locationQuery = label;
            _locationStatus = "Current location auto-populated.";
        }
    }

    private void ConfirmLocation()
    {
        if (_location is null)
        {
            _locationStatus = "No location selected.";
            return;
        }

        _location = _location with { Source = "manual-confirmed" };
        _isLocationConfirmed = true;
        _locationStatus = "Location confirmed.";
    }

    private void EditLocation()
    {
        _isLocationConfirmed = false;
        _locationStatus = "Location edit enabled.";
    }

    private async Task OnLocationQueryInputAsync(ChangeEventArgs args)
    {
        if (_isLocationConfirmed)
        {
            return;
        }

        _locationQuery = args.Value?.ToString() ?? string.Empty;
        await SearchLocationSuggestionsAsync();
    }

    private async Task SearchLocationSuggestionsAsync()
    {
        _locationSearchCts?.Cancel();
        _locationSearchCts?.Dispose();
        _locationSearchCts = new CancellationTokenSource();
        var token = _locationSearchCts.Token;

        var trimmed = _locationQuery.Trim();
        if (trimmed.Length < 3)
        {
            _searchingLocation = false;
            _locationStatus = string.Empty;
            _locationResults.Clear();
            return;
        }

        _searchingLocation = true;
        _locationStatus = string.Empty;
        try
        {
            await Task.Delay(300, token);

            _locationResults.Clear();
            var results = await ApiClient.SearchLocationsAsync(trimmed, token);
            if (token.IsCancellationRequested)
            {
                return;
            }

            _locationResults.AddRange(results);
            if (_locationResults.Count == 0)
            {
                _locationStatus = "No location results found.";
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            if (!token.IsCancellationRequested)
            {
                _locationStatus = $"Location search failed: {ex.Message}";
            }
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _searchingLocation = false;
            }
        }
    }

    private void SelectLocation(LocationSearchResultDto result)
    {
        _location = new OfferLocationDto("search", result.Label, result.Position);
        _locationQuery = result.Label;
        _isLocationConfirmed = false;
        _locationStatus = "Location selected from suggestions.";
        _locationResults.Clear();
    }

    private void AddManualTag()
    {
        AddTag(_manualTag);
        _manualTag = string.Empty;
    }

    private void AddTag(string value)
    {
        var normalized = NormalizeTag(value);
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return;
        }

        if (_tags.Contains(normalized, StringComparer.OrdinalIgnoreCase))
        {
            return;
        }

        _tags.Add(normalized);
    }

    private void RemoveTag(string tag)
    {
        _tags.Remove(tag);
    }

    private async Task CreateOfferAsync()
    {
        _saving = true;
        _status = string.Empty;
        try
        {
            var request = new AddOfferRequest(
                _description.Trim(),
                _tags.ToArray(),
                _image?.Metadata,
                _location,
                _image?.DataUrl);

            var created = await ApiClient.CreateOfferAsync(request, CancellationToken.None);
            if (created is null)
            {
                _status = "Offer creation failed.";
                return;
            }

            _status = $"Offer created with ID {created.OfferId}.";
            Navigation.NavigateTo("/offers", forceLoad: false);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string NormalizeTag(string value) =>
        (value ?? string.Empty)
            .Trim()
            .Trim('.', ',', ';', ':', '!', '?', '"', '\'', '(', ')', '[', ']', '{', '}')
            .ToLowerInvariant();

    private static IReadOnlyList<string> ExtractWords(string text) =>
        Regex.Matches(text ?? string.Empty, "\\b[\\p{L}\\p{Nd}][\\p{L}\\p{Nd}\\-']*%?(?=\\b|\\s|$|[.,;:!?])")
            .Select(m => m.Value)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(30)
            .ToArray();

    private static string FormatLocation(OfferLocationDto? location) =>
        location is null
            ? "Unavailable"
            : location.Label ?? "Current location";

    private string BuildLocationMapUrl()
    {
        if (_location is null)
        {
            return MapRendering.BuildMapEmbedUrl(new GeoPoint(40.7128, -74.0060), [], zoom: 14);
        }

        return MapRendering.BuildLocationPreviewMapUrl(_location.Position, _location.Label, zoom: 15);
    }

    private async Task<string> ResolveAutoLocationLabelAsync(GeoPoint point)
    {
        try
        {
            var result = await ApiClient.ReverseLocationAsync(point, CancellationToken.None);
            if (!string.IsNullOrWhiteSpace(result?.Label))
            {
                return result.Label.Trim();
            }
        }
        catch
        {
            // Fallback label is used when reverse-geocoding is unavailable.
        }

        return "Current location";
    }

    public void Dispose()
    {
        _locationSearchCts?.Cancel();
        _locationSearchCts?.Dispose();
    }
}
