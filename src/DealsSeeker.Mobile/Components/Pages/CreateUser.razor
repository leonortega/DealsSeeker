@page "/create-user"
@inject IDealsSeekerApiClient ApiClient
@inject IUserSessionService Session
@inject NavigationManager Navigation

<h1>Create User</h1>

<section class="card-block">
    <label class="field-label" for="registerName">Name</label>
    <input id="registerName" name="registerName" class="field-input" @bind="_displayName" />

    <label class="field-label" for="registerEmail">Email</label>
    <input id="registerEmail" name="registerEmail" class="field-input" @bind="_email" />

    <label class="field-label" for="registerPassword">Password</label>
    <input id="registerPassword" name="registerPassword" class="field-input" type="password" @bind="_password" />

    <p class="muted">Password must have at least 8 chars, with letters and numbers.</p>

    <button class="btn-main" @onclick="CreateUserAsync" disabled="@_working">Create User</button>

    <p class="muted auth-link-row">
        Already have an account?
        <a href="/login">Login</a>
    </p>
</section>

@if (!string.IsNullOrWhiteSpace(_status))
{
    <section class="card-block">
        <p class="status-line">@_status</p>
    </section>
}

@if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="card-block">
        <p class="status-line error">@_error</p>
    </section>
}

@code {
    private string _displayName = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _status;
    private string? _error;
    private bool _working;

    protected override void OnInitialized()
    {
        if (Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/offers", forceLoad: false);
        }
    }

    private async Task CreateUserAsync()
    {
        if (_working)
        {
            return;
        }

        var displayName = _displayName.Trim();
        var email = _email.Trim();
        var password = _password;

        if (string.IsNullOrWhiteSpace(displayName))
        {
            _error = "Name is required.";
            return;
        }

        if (!IsValidEmail(email))
        {
            _error = "Please enter a valid email.";
            return;
        }

        if (!IsStrongPassword(password))
        {
            _error = "Password must have at least 8 chars, with letters and numbers.";
            return;
        }

        _working = true;
        _status = null;
        _error = null;
        try
        {
            var registerResult = await ApiClient.RegisterUserAsync(
                new RegisterUserRequest(displayName, email, password),
                CancellationToken.None);

            if (!registerResult.Success)
            {
                _error = registerResult.Message;
                return;
            }

            var session = await ApiClient.LoginAsync(new LoginRequest(email, password), CancellationToken.None);
            if (session is null)
            {
                _error = "User created but login failed. Please login manually.";
                return;
            }

            await Session.SetSessionAsync(session, CancellationToken.None);
            _status = "User created.";
            Navigation.NavigateTo("/offers", forceLoad: false);
        }
        catch (Exception ex)
        {
            _error = $"Create user failed: {ex.Message}";
        }
        finally
        {
            _working = false;
        }
    }

    private static bool IsValidEmail(string email) =>
        Regex.IsMatch(email ?? string.Empty, "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$", RegexOptions.CultureInvariant);

    private static bool IsStrongPassword(string password) =>
        password.Length >= 8 &&
        password.Any(char.IsLetter) &&
        password.Any(char.IsDigit);
}
