@page "/create-user"
@inject IDealsSeekerApiClient ApiClient
@inject IUserSessionService Session
@inject IAppPreferencesService Preferences
@inject NavigationManager Navigation

<section class="page-hero auth-hero">
    <div class="page-hero-copy">
        <h1>@T("auth.createUserTitle")</h1>
    </div>
</section>

<section class="auth-grid">
    <section class="card-block auth-brand-panel">
        <img src="/images/dealseeker-icon.svg" alt="" class="auth-brand-icon" />
        <h2>DealsSeeker</h2>
        <p class="muted">@T("auth.passwordHint")</p>
    </section>

    <section class="card-block auth-panel">
        <div class="section-heading">
            <div>
                <h2>@T("auth.createUserButton")</h2>
            </div>
        </div>

        <form class="form-stack" @onsubmit="OnSubmitAsync" autocomplete="on">
            <label class="field-label" for="registerName">@T("auth.name")</label>
            <input id="registerName" name="registerName" class="field-input" autocomplete="name" @bind="_displayName" />

            <label class="field-label" for="registerEmail">@T("auth.email")</label>
            <input id="registerEmail" name="registerEmail" class="field-input" type="email" autocomplete="username" @bind="_email" />

            <label class="field-label" for="registerPassword">@T("auth.password")</label>
            <input id="registerPassword" name="registerPassword" class="field-input" type="password" autocomplete="new-password" @bind="_password" />

            <p class="muted">@T("auth.passwordHint")</p>

            <button class="btn-main btn-main-accent" type="submit" disabled="@_working">@T("auth.createUserButton")</button>

            <p class="muted auth-link-row">
                @T("auth.alreadyHaveAccount")
                <a href="/login">@T("auth.loginLink")</a>
            </p>
        </form>
    </section>
</section>

@if (!string.IsNullOrWhiteSpace(_status))
{
    <section class="card-block">
        <p class="status-line">@_status</p>
    </section>
}

@if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="card-block">
        <p class="status-line error">@_error</p>
    </section>
}

@code {
    private string _displayName = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _status;
    private string? _error;
    private bool _working;

    protected override void OnInitialized()
    {
        if (Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/offers", forceLoad: false);
        }
    }

    private async Task CreateUserAsync()
    {
        if (_working)
        {
            return;
        }

        var displayName = _displayName.Trim();
        var email = _email.Trim();
        var password = _password;

        if (string.IsNullOrWhiteSpace(displayName))
        {
            _error = T("auth.nameRequired");
            return;
        }

        if (!IsValidEmail(email))
        {
            _error = T("auth.validEmailRequired");
            return;
        }

        if (!IsStrongPassword(password))
        {
            _error = T("auth.passwordStrongRequired");
            return;
        }

        _working = true;
        _status = null;
        _error = null;
        try
        {
            var registerResult = await ApiClient.RegisterUserAsync(
                new RegisterUserRequest(displayName, email, password),
                CancellationToken.None);

            if (!registerResult.Success)
            {
                _error = T("auth.createUserRejected");
                return;
            }

            var session = await ApiClient.LoginAsync(new LoginRequest(email, password), CancellationToken.None);
            if (session is null)
            {
                _error = T("auth.userCreatedLoginFailed");
                return;
            }

            await Session.SetSessionAsync(session, CancellationToken.None);
            _status = T("auth.userCreated");
            Navigation.NavigateTo("/offers", forceLoad: false);
        }
        catch (Exception)
        {
            _error = T("auth.createUserFailedPrefix");
        }
        finally
        {
            _working = false;
        }
    }

    private Task OnSubmitAsync()
    {
        return CreateUserAsync();
    }

    private static bool IsValidEmail(string email) =>
        Regex.IsMatch(email ?? string.Empty, "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$", RegexOptions.CultureInvariant);

    private static bool IsStrongPassword(string password) =>
        password.Length >= 8 &&
        password.Any(char.IsLetter) &&
        password.Any(char.IsDigit);

    private string T(string key) => Preferences.Translate(key);
}
