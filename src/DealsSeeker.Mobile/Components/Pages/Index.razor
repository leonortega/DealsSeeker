@page "/"
@inject NavigationManager Navigation
@inject IUserSessionService Session
@inject IDealsSeekerApiClient ApiClient

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", forceLoad: false);
            return;
        }

        try
        {
            var profile = await ApiClient.GetMyProfileAsync(CancellationToken.None);
            if (profile is null)
            {
                await Session.ClearSessionAsync(CancellationToken.None);
                Navigation.NavigateTo("/login", forceLoad: false);
                return;
            }
        }
        catch
        {
            // If validation endpoint is temporarily unavailable, preserve local session flow.
        }

        Navigation.NavigateTo("/offers", forceLoad: false);
    }
}
