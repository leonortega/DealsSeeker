@page "/login"
@inject IDealsSeekerApiClient ApiClient
@inject IUserSessionService Session
@inject IAppPreferencesService Preferences
@inject NavigationManager Navigation

<section class="page-hero auth-hero">
    <div class="page-hero-copy">
        <h1>@T("auth.loginTitle")</h1>
    </div>
</section>

<section class="auth-grid">
    <section class="card-block auth-brand-panel">
        <img src="/images/dealseeker-icon.svg" alt="" class="auth-brand-icon" />
        <h2>DealsSeeker</h2>
    </section>

    <section class="card-block auth-panel">
        <div class="section-heading">
            <div>
                <h2>@T("auth.loginButton")</h2>
            </div>
        </div>

        <form class="form-stack" @onsubmit="OnSubmitAsync" autocomplete="on">
            <label class="field-label" for="loginUser">@T("auth.userEmail")</label>
            <input id="loginUser" name="loginUser" class="field-input" type="email" autocomplete="username" @bind="_email" />

            <label class="field-label" for="loginPassword">@T("auth.password")</label>
            <input id="loginPassword" name="loginPassword" class="field-input" type="password" autocomplete="current-password" @bind="_password" />

            <button class="btn-main btn-main-accent" type="submit" disabled="@_working">@T("auth.loginButton")</button>

            <p class="muted auth-link-row">
                @T("auth.newUser")
                <a href="/create-user">@T("auth.createUserLink")</a>
            </p>
        </form>
    </section>
</section>

@if (!string.IsNullOrWhiteSpace(_status))
{
    <section class="card-block">
        <p class="status-line">@_status</p>
    </section>
}

@if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="card-block">
        <p class="status-line error">@_error</p>
    </section>
}

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _status;
    private string? _error;
    private bool _working;

    protected override void OnInitialized()
    {
        if (Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/offers", forceLoad: false);
        }
    }

    private async Task LoginAsync()
    {
        if (_working)
        {
            return;
        }

        _working = true;
        _status = null;
        _error = null;
        try
        {
            var session = await ApiClient.LoginAsync(
                new LoginRequest(_email.Trim(), _password),
                CancellationToken.None);

            if (session is null)
            {
                _error = T("auth.invalidCredentials");
                return;
            }

            await Session.SetSessionAsync(session, CancellationToken.None);
            _status = T("auth.loginSuccess");
            Navigation.NavigateTo("/offers", forceLoad: false);
        }
        catch (Exception)
        {
            _error = T("auth.loginFailedPrefix");
        }
        finally
        {
            _working = false;
        }
    }

    private Task OnSubmitAsync()
    {
        return LoginAsync();
    }

    private string T(string key) => Preferences.Translate(key);
}
