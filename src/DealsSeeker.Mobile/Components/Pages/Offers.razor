@page "/offers"
@using System.Globalization
@inject IDealsSeekerApiClient ApiClient
@inject IDeviceLocationService DeviceLocation
@inject IMapLauncherService MapLauncher
@inject IMapRenderingService MapRendering
@inject IUserSessionService Session
@inject IReportDraftContext ReportDraftContext
@inject IAppPreferencesService Preferences
@inject NavigationManager Navigation
@implements IDisposable

<h1>@T("offers.title")</h1>

<div class="offers-top-actions">
    <button class="btn-main add-offer-button" @onclick="NavigateToAddOffer" title="@T("nav.addOffer")">+ @T("nav.addOffer")</button>
</div>

<section class="card-block offers-search-panel">
    <label class="field-label" for="offersSearchQuery">@T("offers.searchLabel")</label>
    <div class="search-row">
        <input id="offersSearchQuery"
               name="offersSearchQuery"
               @ref="_searchQueryInput"
               class="field-input"
               @bind="_query"
               placeholder="@T("offers.searchPlaceholder")" />
        <button class="btn-main" @onclick="SearchAsync" disabled="@_loading">@T("offers.searchButton")</button>
    </div>

    <div class="distance-row">
        <label for="coverageRadius">@T("offers.radius"): @_radiusMeters m</label>
        <input id="coverageRadius"
               name="coverageRadius"
               type="range"
               min="100"
               max="5000"
               step="100"
               value="@_radiusMeters"
               @oninput="OnCoverageRadiusInput"
               @onchange="OnCoverageRadiusChangedAsync" />
    </div>

    <label class="offers-favorites-toggle">
        <input type="checkbox" @bind="_favoritesOnly" @bind:after="SearchAsync" />
        <span>@T("offers.favoritesOnly")</span>
    </label>
</section>

<section class="card-block">
    <h2>@T("offers.nearbyMap")</h2>
    <p class="muted">@T("offers.yourLocation"): @_userLocationLabel | @T("offers.provider"): @MapRendering.ActiveProvider</p>
    <iframe class="map-frame" src="@BuildMapEmbedUrl()" loading="lazy"></iframe>
</section>

@if (_promotedOffers.Count > 0)
{
    <section class="card-block">
        <h2>@T("offers.promoted")</h2>
        <div class="offer-grid promoted-grid">
            @foreach (var offer in _promotedOffers)
            {
                <article class="offer-card-square @(offer.IsReported ? "offer-card-reported" : string.Empty)">
                    <button class="offer-image-button" title="@T("offers.details")" @onclick="() => OpenDetail(offer)">
                        <img src="@ResolveOfferImage(offer.ImageUrl)"
                             alt="@T("offers.imageAlt")"
                             class="offer-image-square"
                             onerror="this.onerror=null;this.src='/images/offer-placeholder.svg';" />
                        <span class="offer-badge offer-badge-promoted">@T("offers.promoted")</span>
                        @if (offer.IsReported)
                        {
                            <span class="offer-badge offer-badge-reported">@T("offers.reported")</span>
                        }
                    </button>
                    <div class="offer-square-body">
                        <p class="offer-meta"><span class="offer-meta-label">@T("offers.address"):</span> @offer.BusinessName</p>
                        <p class="offer-meta"><span class="offer-meta-label">@T("offers.distance"):</span> @FormatDistanceMeters(offer.DistanceMeters)</p>
                        <button class="btn-main btn-favorite @(offer.IsFavorite ? "active" : string.Empty)"
                                @onclick="() => ToggleFavoriteAsync(offer)">
                            <span class="favorite-heart" aria-hidden="true">&#10084;</span>
                            <span>@T("offers.favorite")</span>
                        </button>
                        <OfferActions Offer="offer"
                                      VotesDisabled="@IsVoteDisabled(offer)"
                                      OnVote="@(vote => VoteAsync(offer.OfferId, vote))"
                                      OnReport="OpenReportViewAsync" />
                    </div>
                </article>
            }
        </div>
    </section>
}

<section class="card-block">
    <h2>@T("offers.results")</h2>
    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <p class="status-line">@_status</p>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="status-line error">@_error</p>
    }
    else if (_loading)
    {
        <p class="muted">@T("offers.loading")</p>
    }
    else if (_feedOffers.Count == 0)
    {
        <p class="muted">@T("offers.noResults")</p>
    }
    else
    {
        <div class="offer-grid">
            @foreach (var offer in _feedOffers)
            {
                <article class="offer-card-square @(offer.IsReported ? "offer-card-reported" : string.Empty)">
                    <button class="offer-image-button" title="@T("offers.details")" @onclick="() => OpenDetail(offer)">
                        <img src="@ResolveOfferImage(offer.ImageUrl)"
                             alt="@T("offers.imageAlt")"
                             class="offer-image-square"
                             onerror="this.onerror=null;this.src='/images/offer-placeholder.svg';" />
                        @if (offer.IsReported)
                        {
                            <span class="offer-badge offer-badge-reported">@T("offers.reported")</span>
                        }
                    </button>
                    <div class="offer-square-body">
                        <p class="offer-meta"><span class="offer-meta-label">@T("offers.address"):</span> @offer.BusinessName</p>
                        <p class="offer-meta"><span class="offer-meta-label">@T("offers.distance"):</span> @FormatDistanceMeters(offer.DistanceMeters)</p>
                        <button class="btn-main btn-favorite @(offer.IsFavorite ? "active" : string.Empty)"
                                @onclick="() => ToggleFavoriteAsync(offer)">
                            <span class="favorite-heart" aria-hidden="true">&#10084;</span>
                            <span>@T("offers.favorite")</span>
                        </button>
                        <OfferActions Offer="offer"
                                      VotesDisabled="@IsVoteDisabled(offer)"
                                      OnVote="@(vote => VoteAsync(offer.OfferId, vote))"
                                      OnReport="OpenReportViewAsync" />
                    </div>
                </article>
            }
        </div>
    }
</section>

@if (_detailOffer is not null)
{
    <div class="modal-backdrop" @onclick="CloseDetail"></div>
    <section class="offer-detail-modal" role="dialog" aria-modal="true">
        <div class="offer-detail-header">
            <h2>@_detailOffer.BusinessName</h2>
            <button class="btn-main btn-danger" @onclick="CloseDetail">x</button>
        </div>

        <div class="offer-detail-carousel">
            <button class="btn-main" @onclick="PreviousImage" disabled="@(GetDetailImages().Count <= 1)">&#8592;</button>
            <img src="@CurrentDetailImage()"
                 alt="@T("offers.imageAlt")"
                 class="offer-detail-image"
                 @onclick="OpenFullscreen"
                 onerror="this.onerror=null;this.src='/images/offer-placeholder.svg';" />
            <button class="btn-main" @onclick="NextImage" disabled="@(GetDetailImages().Count <= 1)">&#8594;</button>
        </div>

        <p>@((MarkupString)HighlightText(_detailOffer.Description))</p>
        <p class="muted">@T("offers.distance"): @FormatDistanceMeters(_detailOffer.DistanceMeters)</p>
        <div class="tag-list">
            @foreach (var tag in _detailOffer.Tags)
            {
                <span class="tag-pill">@tag</span>
            }
        </div>

        <div class="action-row">
            <button class="btn-main" @onclick="() => OpenDirectionsAsync(_detailOffer.Location)">@T("offers.directions")</button>
            <button class="btn-main btn-favorite @(_detailOffer.IsFavorite ? "active" : string.Empty)"
                    @onclick="() => ToggleFavoriteAsync(_detailOffer)">
                <span class="favorite-heart" aria-hidden="true">&#10084;</span>
                <span>@T("offers.favorite")</span>
            </button>
        </div>
    </section>
}

@if (_fullscreenImageOpen)
{
    <div class="modal-backdrop" @onclick="CloseFullscreen"></div>
    <section class="image-fullscreen-modal" role="dialog" aria-modal="true">
        <button class="btn-main btn-danger" @onclick="CloseFullscreen">x</button>
        <img src="@CurrentDetailImage()"
             alt="@T("offers.fullscreenImageAlt")"
             class="image-fullscreen"
             onerror="this.onerror=null;this.src='/images/offer-placeholder.svg';" />
    </section>
}

@code {
    private string _query = string.Empty;
    private string? _status;
    private string? _error;
    private bool _loading;
    private bool _favoritesOnly;
    private int _radiusMeters = 1500;
    private GeoPoint _userLocation = new(40.7128, -74.0060);
    private string _userLocationLabel = string.Empty;
    private SearchOffersResponse _results = new([], []);
    private List<OfferItemDto> _promotedOffers = [];
    private List<OfferItemDto> _feedOffers = [];
    private ElementReference _searchQueryInput;
    private OfferItemDto? _detailOffer;
    private int _detailImageIndex;
    private bool _fullscreenImageOpen;
    private string _renderedLanguage = "en";

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", forceLoad: false);
            return;
        }

        await Preferences.InitializeAsync(Session.CurrentSession?.UserId, CancellationToken.None);
        Preferences.Changed += OnPreferencesChanged;
        _renderedLanguage = Preferences.Language;

        try
        {
            var location = await DeviceLocation.TryGetCurrentLocationAsync(CancellationToken.None);
            if (location is not null)
            {
                _userLocation = location;
                await TryResolveUserLocationLabelAsync(location);
            }
            else
            {
                _userLocationLabel = CurrentLocationFallback();
            }
        }
        catch
        {
            _userLocationLabel = CurrentLocationFallback();
        }

        await SearchAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Session.IsAuthenticated)
        {
            return;
        }

        try
        {
            await _searchQueryInput.FocusAsync();
        }
        catch
        {
        }
    }

    private async Task SearchAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var request = new SearchOffersRequest(
                _query,
                _userLocation,
                _radiusMeters,
                Locale: Preferences.Language,
                FavoritesOnly: _favoritesOnly);

            _results = await ApiClient.SearchOffersAsync(request, CancellationToken.None);
            PartitionOfferSets();
        }
        catch (Exception)
        {
            _error = T("offers.searchFailed");
        }
        finally
        {
            _loading = false;
        }
    }

    private void PartitionOfferSets()
    {
        var isPreSearch = string.IsNullOrWhiteSpace(_query);
        if (isPreSearch)
        {
            _promotedOffers = _results.Offers
                .Where(offer => offer.IsPromoted && !offer.IsReported)
                .ToList();

            var promotedIds = _promotedOffers.Select(x => x.OfferId).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _feedOffers = _results.Offers
                .Where(offer => !promotedIds.Contains(offer.OfferId))
                .ToList();
            return;
        }

        _promotedOffers = [];
        _feedOffers = _results.Offers.ToList();
    }

    private void OnCoverageRadiusInput(ChangeEventArgs args)
    {
        if (args.Value is null)
        {
            return;
        }

        if (int.TryParse(args.Value.ToString(), out var parsed))
        {
            _radiusMeters = Math.Clamp(parsed, 100, 5000);
        }
    }

    private async Task OnCoverageRadiusChangedAsync(ChangeEventArgs args)
    {
        OnCoverageRadiusInput(args);
        await SearchAsync();
    }

    private async Task OpenDirectionsAsync(GeoPoint destination)
    {
        await MapLauncher.OpenWalkingDirectionsAsync(destination, CancellationToken.None);
    }

    private async Task ToggleFavoriteAsync(OfferItemDto offer)
    {
        var result = await ApiClient.SetOfferFavoriteAsync(
            offer.OfferId,
            new SetFavoriteRequest(!offer.IsFavorite),
            CancellationToken.None);

        if (!result.Success)
        {
            _error = T("offers.favoriteUpdateFailed");
            return;
        }

        _status = T("offers.favoriteUpdated");
        await SearchAsync();

        if (_detailOffer is not null && _detailOffer.OfferId.Equals(offer.OfferId, StringComparison.OrdinalIgnoreCase))
        {
            _detailOffer = _results.Offers.FirstOrDefault(x => x.OfferId.Equals(offer.OfferId, StringComparison.OrdinalIgnoreCase));
            _detailImageIndex = 0;
        }
    }

    private async Task VoteAsync(string offerId, OfferAvailabilityVoteType vote)
    {
        if (!Session.IsAuthenticated)
        {
            _error = T("offers.loginRequiredVote");
            return;
        }

        var result = await ApiClient.VoteOfferAvailabilityAsync(offerId, new OfferAvailabilityVoteRequest(vote), CancellationToken.None);
        if (!result.Success)
        {
            _error = T("offers.voteFailed");
            if (result.Message.Contains("already submitted", StringComparison.OrdinalIgnoreCase))
            {
                _error = T("offers.voteAlreadySubmitted");
                await SearchAsync();
            }

            return;
        }

        _status = T("offers.feedbackRegistered");
        await SearchAsync();
    }

    private Task OpenReportViewAsync(OfferItemDto offer)
    {
        var userId = Session.CurrentSession?.UserId ?? T("common.unknown");
        var now = DateTimeOffset.UtcNow;
        var initialMessage = string.Format(
            T("offers.reportDraftOpened"),
            offer.OfferId,
            now.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.InvariantCulture));
        ReportDraftContext.Set(new OfferReportDraft(
            offer,
            userId,
            now,
            initialMessage));

        Navigation.NavigateTo("/reports");
        return Task.CompletedTask;
    }

    private void OpenDetail(OfferItemDto offer)
    {
        _detailOffer = offer;
        _detailImageIndex = 0;
        _fullscreenImageOpen = false;
    }

    private void CloseDetail()
    {
        _detailOffer = null;
        _detailImageIndex = 0;
        _fullscreenImageOpen = false;
    }

    private void OpenFullscreen()
    {
        _fullscreenImageOpen = true;
    }

    private void CloseFullscreen()
    {
        _fullscreenImageOpen = false;
    }

    private void NextImage()
    {
        var images = GetDetailImages();
        if (images.Count <= 1)
        {
            return;
        }

        _detailImageIndex = (_detailImageIndex + 1) % images.Count;
    }

    private void PreviousImage()
    {
        var images = GetDetailImages();
        if (images.Count <= 1)
        {
            return;
        }

        _detailImageIndex = (_detailImageIndex - 1 + images.Count) % images.Count;
    }

    private IReadOnlyList<string> GetDetailImages()
    {
        if (_detailOffer is null || _detailOffer.ImageUrls.Count == 0)
        {
            return ["/images/offer-placeholder.svg"];
        }

        return _detailOffer.ImageUrls;
    }

    private string CurrentDetailImage()
    {
        var images = GetDetailImages();
        var clampedIndex = Math.Clamp(_detailImageIndex, 0, images.Count - 1);
        return ResolveOfferImage(images[clampedIndex]);
    }

    private string HighlightText(string description)
    {
        var words = Regex.Split(_query ?? string.Empty, "\\s+")
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

        var encoded = System.Net.WebUtility.HtmlEncode(description);
        foreach (var word in words)
        {
            var pattern = Regex.Escape(System.Net.WebUtility.HtmlEncode(word));
            encoded = Regex.Replace(
                encoded,
                pattern,
                m => $"<mark>{m.Value}</mark>",
                RegexOptions.IgnoreCase);
        }

        return encoded;
    }

    private string BuildMapEmbedUrl()
    {
        var zoom = CalculateMapZoomForCoverage(_radiusMeters, _userLocation.Lat);
        return MapRendering.BuildMapEmbedUrl(_userLocation, _results.Businesses, zoom);
    }

    private static int CalculateMapZoomForCoverage(int radiusMeters, double latitude)
    {
        var safeRadius = Math.Max(100, radiusMeters);
        var clampedLatitude = Math.Clamp(latitude, -85d, 85d);
        var latitudeRadians = clampedLatitude * (Math.PI / 180d);

        const double metersPerPixelAtZoom0 = 156543.03392;
        const double assumedMapWidthPixels = 420d;
        const double diameterCoverageRatio = 0.75d;
        var targetMetersPerPixel = (2d * safeRadius) / (assumedMapWidthPixels * diameterCoverageRatio);

        var latitudeScale = Math.Max(0.1d, Math.Cos(latitudeRadians));
        var rawZoom = Math.Log((metersPerPixelAtZoom0 * latitudeScale) / targetMetersPerPixel, 2d);
        return (int)Math.Clamp(Math.Round(rawZoom, MidpointRounding.AwayFromZero), 2, 18);
    }

    private bool IsVoteDisabled(OfferItemDto offer) =>
        !Session.IsAuthenticated || offer.HasCurrentUserVoted;

    private static string FormatDistanceMeters(double distanceMeters) =>
        $"{Math.Round(Math.Max(0, distanceMeters))} m";

    private async Task TryResolveUserLocationLabelAsync(GeoPoint point)
    {
        try
        {
            var resolved = await ApiClient.ReverseLocationAsync(point, CancellationToken.None);
            if (!string.IsNullOrWhiteSpace(resolved?.Label))
            {
                _userLocationLabel = resolved.Label.Trim();
                return;
            }
        }
        catch
        {
        }

        _userLocationLabel = CurrentLocationFallback();
    }

    private void NavigateToAddOffer() => Navigation.NavigateTo("/add-offer");

    private string T(string key) => Preferences.Translate(key);

    private string CurrentLocationFallback() => T("offers.currentLocation");

    private void OnPreferencesChanged()
    {
        _ = InvokeAsync(async () =>
        {
            var languageChanged = !string.Equals(_renderedLanguage, Preferences.Language, StringComparison.OrdinalIgnoreCase);
            _renderedLanguage = Preferences.Language;
            if (languageChanged && Session.IsAuthenticated)
            {
                await SearchAsync();
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Preferences.Changed -= OnPreferencesChanged;
    }

    private static string ResolveOfferImage(string imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return "/images/offer-placeholder.svg";
        }

        return imageUrl;
    }
}
