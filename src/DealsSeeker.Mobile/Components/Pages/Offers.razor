@page "/offers"
@inject IDealsSeekerApiClient ApiClient
@inject IDeviceLocationService DeviceLocation
@inject IMapLauncherService MapLauncher
@inject IMapRenderingService MapRendering
@inject IUserSessionService Session
@inject IReportDraftContext ReportDraftContext
@inject NavigationManager Navigation

<h1>Offers</h1>

<div class="offers-top-actions">
    <button class="btn-main add-offer-button" @onclick="NavigateToAddOffer" title="Add new offer">+ add new offer</button>
</div>

<section class="card-block offers-search-panel">
    <div class="search-row">
        <input class="field-input" @bind="_query" placeholder="Search by product tag..." />
    </div>

    <button class="btn-main offers-search-submit" @onclick="SearchAsync" disabled="@_loading">Search</button>
</section>

<section class="card-block">
    <h2>Nearby Map</h2>
    <p class="muted">Your location: @FormatLocation(_userLocation) | Provider: @MapRendering.ActiveProvider</p>
    <iframe class="map-frame" src="@BuildMapEmbedUrl()" loading="lazy"></iframe>
    <div class="distance-row">
        <label>Coverage radius: @_radiusMeters m</label>
        <input type="range" min="100" max="5000" step="100" @bind="_radiusMeters" @bind:event="oninput" />
    </div>

    @if (_results.Businesses.Count == 0)
    {
        <p class="muted">No business markers found for the current filter.</p>
    }
    else
    {
        <div class="marker-list">
            @foreach (var marker in _results.Businesses)
            {
                <button class="marker-chip" @onclick="() => OpenDirectionsAsync(marker.Location)">
                    @marker.Name (@Math.Round(marker.DistanceMeters) m)
                </button>
            }
        </div>
    }
</section>

<section class="card-block">
    <h2>Offers</h2>
    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <p class="status-line">@_status</p>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="status-line error">@_error</p>
    }
    else if (_loading)
    {
        <p class="muted">Loading offers...</p>
    }
    else if (_results.Offers.Count == 0)
    {
        <p class="muted">No offers found.</p>
    }
    else
    {
        @foreach (var offer in _results.Offers)
        {
            <article class="offer-card offer-card-clickable"
                     title="Open walking directions"
                     @onclick="() => OpenDirectionsAsync(offer.Location)">
                <img src="@ResolveOfferImage(offer.ImageUrl)"
                     alt="Offer image"
                     class="offer-image"
                     onerror="this.onerror=null;this.src='/images/offer-placeholder.svg';" />
                <div class="offer-body">
                    <h3>@offer.BusinessName</h3>
                    <p>@((MarkupString)HighlightText(offer.Description))</p>
                    <div class="tag-list">
                        @foreach (var tag in offer.Tags)
                        {
                            <span class="tag-pill">@tag</span>
                        }
                    </div>
                    <OfferActions Offer="offer"
                                  VotesDisabled="@IsVoteDisabled(offer)"
                                  OnVote="@(vote => VoteAsync(offer.OfferId, vote))"
                                  OnReport="OpenReportViewAsync" />
                </div>
            </article>
        }
    }
</section>

@code {
    private string _query = string.Empty;
    private string? _status;
    private string? _error;
    private bool _loading;
    private int _radiusMeters = 1500;
    private GeoPoint _userLocation = new(40.7128, -74.0060);
    private SearchOffersResponse _results = new([], []);

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", forceLoad: false);
            return;
        }

        var location = await DeviceLocation.TryGetCurrentLocationAsync(CancellationToken.None);
        if (location is not null)
        {
            _userLocation = location;
        }

        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var request = new SearchOffersRequest(_query, _userLocation, _radiusMeters);
            _results = await ApiClient.SearchOffersAsync(request, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = $"Search failed: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenDirectionsAsync(GeoPoint destination)
    {
        await MapLauncher.OpenWalkingDirectionsAsync(destination, CancellationToken.None);
    }

    private async Task VoteAsync(string offerId, OfferAvailabilityVoteType vote)
    {
        if (!Session.IsAuthenticated)
        {
            _error = "Login is required to vote offer availability.";
            return;
        }

        var result = await ApiClient.VoteOfferAvailabilityAsync(offerId, new OfferAvailabilityVoteRequest(vote), CancellationToken.None);
        if (!result.Success)
        {
            _error = result.Message;
            if (result.Message.Contains("already submitted", StringComparison.OrdinalIgnoreCase))
            {
                await SearchAsync();
            }

            return;
        }

        _status = "Availability feedback registered.";
        await SearchAsync();
    }

    private Task OpenReportViewAsync(OfferItemDto offer)
    {
        var userId = Session.CurrentSession?.UserId ?? "unknown";
        var now = DateTimeOffset.UtcNow;
        var initialMessage = $"Report opened from offer {offer.OfferId} at {now:yyyy-MM-dd HH:mm:ss} UTC.";
        ReportDraftContext.Set(new OfferReportDraft(
            offer,
            userId,
            now,
            initialMessage));

        Navigation.NavigateTo("/reports");
        return Task.CompletedTask;
    }

    private void NavigateToAddOffer() => Navigation.NavigateTo("/add-offer");

    private string FormatLocation(GeoPoint? point) =>
        point is null ? "Unavailable" : $"{point.Lat:F5}, {point.Lng:F5}";

    private string HighlightText(string description)
    {
        var words = Regex.Split(_query ?? string.Empty, "\\s+")
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

        var encoded = System.Net.WebUtility.HtmlEncode(description);
        foreach (var word in words)
        {
            var pattern = Regex.Escape(System.Net.WebUtility.HtmlEncode(word));
            encoded = Regex.Replace(
                encoded,
                pattern,
                m => $"<mark>{m.Value}</mark>",
                RegexOptions.IgnoreCase);
        }

        return encoded;
    }

    private string BuildMapEmbedUrl() =>
        MapRendering.BuildMapEmbedUrl(_userLocation, _results.Businesses, zoom: 15);

    private bool IsVoteDisabled(OfferItemDto offer) =>
        !Session.IsAuthenticated || offer.HasCurrentUserVoted;

    private static string ResolveOfferImage(string imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return "/images/offer-placeholder.svg";
        }

        if (imageUrl.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase) ||
            imageUrl.StartsWith("/images/", StringComparison.OrdinalIgnoreCase))
        {
            return "/images/offer-placeholder.svg";
        }

        return imageUrl;
    }
}
