@page "/offers"
@inject IDealsSeekerApiClient ApiClient
@inject IDeviceLocationService DeviceLocation
@inject IMapLauncherService MapLauncher
@inject NavigationManager Navigation

<h1>Offers</h1>

<section class="card-block">
    <div class="search-row">
        <input class="field-input" @bind="_query" placeholder="Search by product tag..." />
        <button class="btn-main btn-icon" @onclick="NavigateToAddOffer" title="Add Offer">+</button>
    </div>

    <button class="btn-main" @onclick="SearchAsync" disabled="@_loading">Search</button>
</section>

<section class="card-block">
    <h2>Nearby Map</h2>
    <p class="muted">Your location: @FormatLocation(_userLocation)</p>
    <iframe class="map-frame" src="@BuildMapEmbedUrl()" loading="lazy"></iframe>
    <div class="distance-row">
        <label>Coverage radius: @_radiusMeters m</label>
        <input type="range" min="100" max="5000" step="100" @bind="_radiusMeters" @bind:event="oninput" />
    </div>

    @if (_results.Businesses.Count == 0)
    {
        <p class="muted">No business markers found for the current filter.</p>
    }
    else
    {
        <div class="marker-list">
            @foreach (var marker in _results.Businesses)
            {
                <button class="marker-chip" @onclick="() => OpenDirectionsAsync(marker.Location)">
                    @marker.Name (@Math.Round(marker.DistanceMeters) m)
                </button>
            }
        </div>
    }
</section>

<section class="card-block">
    <h2>Offers</h2>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="status-line error">@_error</p>
    }
    else if (_loading)
    {
        <p class="muted">Loading offers...</p>
    }
    else if (_results.Offers.Count == 0)
    {
        <p class="muted">No offers found.</p>
    }
    else
    {
        @foreach (var offer in _results.Offers)
        {
            <article class="offer-card offer-card-clickable"
                     title="Open walking directions"
                     @onclick="() => OpenDirectionsAsync(offer.Location)">
                <img src="@offer.ImageUrl" alt="Offer image" class="offer-image" />
                <div class="offer-body">
                    <h3>@offer.BusinessName</h3>
                    <p>@((MarkupString)HighlightText(offer.Description))</p>
                    <div class="tag-list">
                        @foreach (var tag in offer.Tags)
                        {
                            <span class="tag-pill">@tag</span>
                        }
                    </div>
                    <div class="action-row">
                        <span class="availability-label">Available?</span>
                        <button class="btn-main btn-vote"
                                title="Thumbs up"
                                @onclick="() => VoteAsync(offer.OfferId, OfferAvailabilityVoteType.ThumbsUp)"
                                @onclick:stopPropagation="true">&#128077; @offer.PositiveAvailabilityCount</button>
                        <button class="btn-main btn-warning btn-vote"
                                title="Thumbs down"
                                @onclick="() => VoteAsync(offer.OfferId, OfferAvailabilityVoteType.ThumbsDown)"
                                @onclick:stopPropagation="true">&#128078; @offer.NegativeAvailabilityCount</button>
                        <button class="btn-main btn-danger"
                                @onclick="() => ReportAsync(offer.OfferId)"
                                @onclick:stopPropagation="true">Report</button>
                    </div>
                </div>
            </article>
        }
    }
</section>

@code {
    private string _query = string.Empty;
    private string? _error;
    private bool _loading;
    private int _radiusMeters = 1500;
    private GeoPoint _userLocation = new(40.7128, -74.0060);
    private SearchOffersResponse _results = new([], []);

    protected override async Task OnInitializedAsync()
    {
        var location = await DeviceLocation.TryGetCurrentLocationAsync(CancellationToken.None);
        if (location is not null)
        {
            _userLocation = location;
        }

        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var request = new SearchOffersRequest(_query, _userLocation, _radiusMeters);
            _results = await ApiClient.SearchOffersAsync(request, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = $"Search failed: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenDirectionsAsync(GeoPoint destination)
    {
        await MapLauncher.OpenWalkingDirectionsAsync(destination, CancellationToken.None);
    }

    private async Task VoteAsync(string offerId, OfferAvailabilityVoteType vote)
    {
        await ApiClient.VoteOfferAvailabilityAsync(offerId, new OfferAvailabilityVoteRequest(vote), CancellationToken.None);
        await SearchAsync();
    }

    private async Task ReportAsync(string offerId)
    {
        await ApiClient.ReportOfferAsync(offerId, new ReportOfferRequest("User report"), CancellationToken.None);
    }

    private void NavigateToAddOffer() => Navigation.NavigateTo("/add-offer");

    private string FormatLocation(GeoPoint? point) =>
        point is null ? "Unavailable" : $"{point.Lat:F5}, {point.Lng:F5}";

    private string HighlightText(string description)
    {
        var words = Regex.Split(_query ?? string.Empty, "\\s+")
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

        var encoded = System.Net.WebUtility.HtmlEncode(description);
        foreach (var word in words)
        {
            var pattern = Regex.Escape(System.Net.WebUtility.HtmlEncode(word));
            encoded = Regex.Replace(
                encoded,
                pattern,
                m => $"<mark>{m.Value}</mark>",
                RegexOptions.IgnoreCase);
        }

        return encoded;
    }

    private string BuildMapEmbedUrl() =>
        $"https://maps.google.com/maps?q={_userLocation.Lat.ToString(System.Globalization.CultureInfo.InvariantCulture)},{_userLocation.Lng.ToString(System.Globalization.CultureInfo.InvariantCulture)}&z=15&output=embed";
}
