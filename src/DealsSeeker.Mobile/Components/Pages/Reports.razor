@page "/reports"
@page "/complaints"
@inject IDealsSeekerApiClient ApiClient
@inject IUserSessionService Session
@inject IReportDraftContext ReportDraftContext
@inject IAppPreferencesService Preferences
@inject NavigationManager Navigation

<section class="page-hero">
    <div class="page-hero-copy">
        <h1>@T("reports.title")</h1>
    </div>
</section>

@if (_previewOffer is not null)
{
    <section class="card-block">
        <div class="section-heading">
            <div>
                <h2>@T("reports.offerPreview")</h2>
            </div>
        </div>

        <article class="offer-card-square offer-card-modern report-preview-card">
            <div class="offer-image-button">
                <img src="@ResolveOfferImage(_previewOffer.ImageUrl)"
                     alt="@T("offers.imageAlt")"
                     class="offer-image-square"
                     onerror="this.onerror=null;this.src='/images/offer-placeholder.svg';" />
                <span class="offer-image-scrim"></span>
            </div>
            <div class="offer-square-body">
                <div class="offer-card-heading">
                    <h3>@_previewOffer.BusinessName</h3>
                    <p class="offer-description-preview">@_previewOffer.Description</p>
                </div>
                <div class="tag-list offer-tag-list">
                    @foreach (var tag in _previewOffer.Tags)
                    {
                        <span class="tag-pill">@tag</span>
                    }
                </div>
            </div>
        </article>
    </section>
}

<section class="card-block compose-section">
    <div class="section-heading">
        <div>
            <h2>@T("reports.sendReport")</h2>
        </div>
    </div>

    <label class="field-label" for="reportUserId">@T("reports.userId")</label>
    <input id="reportUserId" name="reportUserId" class="field-input" @bind="_userId" readonly />

    <label class="field-label" for="reportMessage">@T("reports.reportText")</label>
    <textarea id="reportMessage" name="reportMessage" class="field-input field-textarea" @bind="_message" rows="5"></textarea>

    <label class="field-label" for="reportOfferId">@T("reports.offerId")</label>
    <input id="reportOfferId" name="reportOfferId" class="field-input" @bind="_offerId" readonly="@_fromOfferSelection" />

    <label class="field-label" for="reportDate">@T("reports.dateUtc")</label>
    <input id="reportDate" name="reportDate" class="field-input" value="@FormatUtc(_reportedAtUtc)" readonly />

    <button class="btn-secondary btn-danger" @onclick="SubmitAsync" disabled="@_submitting">@T("reports.sendReport")</button>
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <p class="status-line">@_statusMessage</p>
    }
</section>

@code {
    private string _message = string.Empty;
    private string _offerId = string.Empty;
    private string _userId = string.Empty;
    private DateTimeOffset _reportedAtUtc = DateTimeOffset.UtcNow;
    private OfferItemDto? _previewOffer;
    private bool _fromOfferSelection;
    private string _statusMessage = string.Empty;
    private bool _submitting;

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", forceLoad: false);
            return;
        }

        _userId = Session.CurrentSession?.UserId ?? string.Empty;
        var draft = ReportDraftContext.Consume();
        if (draft is null)
        {
            _reportedAtUtc = DateTimeOffset.UtcNow;
            return;
        }

        _fromOfferSelection = true;
        _previewOffer = draft.Offer;
        _offerId = draft.Offer.OfferId;
        _userId = draft.UserId;
        _reportedAtUtc = draft.ReportedAtUtc;
        _message = draft.InitialMessage;
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        try
        {
            var result = await ApiClient.SubmitReportAsync(
                new ReportRequest(
                    _message.Trim(),
                    string.IsNullOrWhiteSpace(_offerId) ? null : _offerId.Trim(),
                    string.IsNullOrWhiteSpace(_userId) ? null : _userId.Trim(),
                    _reportedAtUtc),
                CancellationToken.None);
            if (result.Success)
            {
                _statusMessage = T("reports.submitSuccess");
                _message = string.Empty;
                _offerId = string.Empty;
                _previewOffer = null;
                _fromOfferSelection = false;
                _reportedAtUtc = DateTimeOffset.UtcNow;
                Navigation.NavigateTo("/offers", forceLoad: false);
            }
            else
            {
                _statusMessage = T("reports.submitFailed");
            }
        }
        catch (Exception)
        {
            _statusMessage = T("reports.submitFailed");
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string ResolveOfferImage(string imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return "/images/offer-placeholder.svg";
        }

        if (imageUrl.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase) ||
            imageUrl.StartsWith("/images/", StringComparison.OrdinalIgnoreCase))
        {
            return "/images/offer-placeholder.svg";
        }

        return imageUrl;
    }

    private static string FormatUtc(DateTimeOffset value) =>
        value.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'");

    private string T(string key) => Preferences.Translate(key);
}
