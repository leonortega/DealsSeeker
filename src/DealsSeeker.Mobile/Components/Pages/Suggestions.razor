@page "/suggestions"
@inject IDealsSeekerApiClient ApiClient
@inject IAppPreferencesService Preferences
@inject NavigationManager Navigation

<h1>@T("suggestions.title")</h1>

<section class="card-block">
    <label class="field-label" for="suggestionMessage">@T("suggestions.suggestion")</label>
    <textarea id="suggestionMessage" name="suggestionMessage" class="field-input" @bind="_message" rows="4"></textarea>

    <label class="field-label" for="suggestionContact">@T("suggestions.contactOptional")</label>
    <input id="suggestionContact" name="suggestionContact" class="field-input" @bind="_contact" />

    <button class="btn-main" @onclick="SubmitAsync" disabled="@_submitting">@T("suggestions.send")</button>
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <p class="status-line">@_statusMessage</p>
    }
</section>

@code {
    private string _message = string.Empty;
    private string _contact = string.Empty;
    private string _statusMessage = string.Empty;
    private bool _submitting;

    private async Task SubmitAsync()
    {
        _submitting = true;
        try
        {
            var result = await ApiClient.SubmitSuggestionAsync(new SuggestionRequest(_message.Trim(), string.IsNullOrWhiteSpace(_contact) ? null : _contact.Trim()), CancellationToken.None);
            if (result.Success)
            {
                _statusMessage = T("suggestions.submitSuccess");
                _message = string.Empty;
                _contact = string.Empty;
                Navigation.NavigateTo("/offers", forceLoad: false);
            }
            else
            {
                _statusMessage = T("suggestions.submitFailed");
            }
        }
        catch (Exception)
        {
            _statusMessage = T("suggestions.submitFailed");
        }
        finally
        {
            _submitting = false;
        }
    }

    private string T(string key) => Preferences.Translate(key);
}
