{
  "expo": {
    "name": "DealsSeeker",
    "slug": "dealsseeker-react-native",
    "scheme": "dealsseeker",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#719377",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.anonymous.dealsseekerreactnative"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#faf8f5",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121417"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ebe8152e-24d7-4b2a-a813-74e303fcd8a3"
      }
    }
  }
}
