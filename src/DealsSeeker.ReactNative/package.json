{
  "name": "dealsseeker.reactnative",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "powershell -ExecutionPolicy Bypass -File ..\\..\\scripts\\run-reactnative-android.ps1",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:e2e": "node ../../test/e2e/device/run.cjs",
    "test:e2e:device": "node ../../test/e2e/device/run.cjs",
    "test:perf": "node ../../test/performance/run.cjs",
    "test:arch": "node ../../test/architecture/client/naming-conventions.cjs && depcruise --config ../../test/architecture/client/dependency-cruiser.config.cjs src"
  },
  "dependencies": {
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "~58.0.26",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "^2.33.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "dependency-cruiser": "^18.8.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
